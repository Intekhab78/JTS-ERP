# Development Configuration
# VITE_API_MODE options:
#   'online' - Connect to online backend (https://erpapi.jtsmiddleeast.com)
#   'local'  - Connect to local backend (http://localhost:5000) [DEFAULT FOR DEV]
VITE_API_MODE=local

# Local Backend Settings
VITE_LOCAL_API_URL=http://localhost:5000/api/v1
VITE_LOCAL_BACKEND_URL=http://localhost:5000

# Online Backend Settings
VITE_ONLINE_API_URL=https://erpapi.jtsmiddleeast.com/api/v1
VITE_ONLINE_BACKEND_URL=https://erpapi.jtsmiddleeast.com
