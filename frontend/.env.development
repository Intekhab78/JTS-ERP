# Development Configuration
# VITE_API_MODE options:
#   'auto'   - Auto-checks if local backend is reachable; if not, uses online backend
#   'local'  - Always connect to local backend (http://localhost:5000)
#   'online' - Always connect to online backend (https://erpapi.jtsonline.shop)
VITE_API_MODE=auto

# Local Backend Settings
VITE_LOCAL_API_URL=http://localhost:5000/api/v1
VITE_LOCAL_BACKEND_URL=http://localhost:5000

# Online Backend Settings
VITE_ONLINE_API_URL=https://erpapi.jtsonline.shop/api/v1
VITE_ONLINE_BACKEND_URL=https://erpapi.jtsonline.shop
